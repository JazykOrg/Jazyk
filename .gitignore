# Rust
/bootstrap/target/

# Compiled set state stays out of this repository, including the `ds_*/` state the
# generated `.jazyk/.gitignore` files keep. A nested ignore file outranks this one,
# so the whole directory is excluded and git never reads them. The configuration
# (`.jazyk/jazyk.toml`, `.jazyk/.gitignore`) is tracked and stays tracked. Stage a
# change to it with `git add -u` (a plain `git add` stages it but exits 1); a new
# project adds its configuration with `git add -f`.
**/.jazyk/
.jazyk.*
project2/
.loop-logs/

# Build caches left by checkouts from before the editor moved to jazyk-cloud/web.
/bootstrap/app/

# Persistent development worktrees.
/.worktrees/

# Local acceptance evidence and development overrides.
/.local/

# Release artifacts.
/dist/
__pycache__/

# Node dependencies (root tooling, the VS Code extension).
node_modules/
