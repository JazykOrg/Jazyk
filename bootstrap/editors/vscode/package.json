{
  "name": "jazyk",
  "displayName": "Jazyk",
  "description": "Language support for Jazyk: natural language compiled into a semantic graph.",
  "version": "0.2.2",
  "publisher": "jazyk",
  "engines": {
    "vscode": "^1.76.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "workspaceContains:**/.jazyk/jazyk.toml"
  ],
  "contributes": {
    "commands": [
      {
        "command": "jazyk.restartServer",
        "title": "Jazyk: Restart Language Server"
      },
      {
        "command": "jazyk.answer",
        "title": "Jazyk: Answer a Question"
      },
      {
        "command": "jazyk.markDocuments",
        "title": "Jazyk: Mark as Documents\u2026"
      },
      {
        "command": "jazyk.markSource",
        "title": "Jazyk: Mark as Source\u2026"
      },
      {
        "command": "jazyk.compileSets",
        "title": "Jazyk: Compile Document Sets\u2026"
      }
    ],
    "configuration": {
      "title": "Jazyk",
      "properties": {
        "jazyk.server.path": {
          "type": "string",
          "default": "",
          "description": "Path to the jazyk binary. When empty, the extension looks for bootstrap/target/release/jazyk, then bootstrap/target/debug/jazyk in the workspace, then falls back to `jazyk` on PATH."
        }
      }
    },
    "menus": {
      "explorer/context": [
        {
          "command": "jazyk.markDocuments",
          "when": "resourceScheme == file",
          "group": "jazyk@1"
        },
        {
          "command": "jazyk.markSource",
          "when": "resourceScheme == file",
          "group": "jazyk@2"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.75.0",
    "typescript": "^5.3.0"
  }
}
